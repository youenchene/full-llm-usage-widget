#!/usr/bin/env bash
set -euo pipefail

# Build the app icon: render a 1024 base PNG (CoreGraphics), assemble a .iconset, and compile a
# .icns via iconutil. Output lands in Support/AppIcon.icns, which run.sh bundles into the .app.
#
# Requires only what ships with macOS: swift, sips, iconutil.

cd "$(dirname "$0")"

OUT_DIR=".build/icon"
ICONSET="$OUT_DIR/AppIcon.iconset"
BASE="$OUT_DIR/icon_1024x1024.png"
ICNS="Support/AppIcon.icns"

mkdir -p "$OUT_DIR" "$(dirname "$ICNS")"

echo "== render =="
swift Scripts/render_icon.swift "$BASE"

echo "== iconset =="
rm -rf "$ICONSET"
mkdir -p "$ICONSET"
for s in 16 32 128 256 512; do
  d=$((s * 2))
  sips -z "$s" "$s" "$BASE" --out "$ICONSET/icon_${s}x${s}.png" >/dev/null
  sips -z "$d" "$d" "$BASE" --out "$ICONSET/icon_${s}x${s}@2x.png" >/dev/null
done

echo "== icns =="
iconutil -c icns "$ICONSET" -o "$ICNS"

echo "Wrote $ICNS"
